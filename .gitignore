# Ignorados del repositorio del Orquestador (Go).
# La configuración real vive en .env, que no se versiona; .env.example sí se versiona.

# --- Entorno y secretos -------------------------------------------------------
.env
.envrc

# --- Binarios y artefactos de compilación ------------------------------------
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
/bin/
/orchestrator

# --- Cobertura ----------------------------------------------------------------
coverage.out
coverage.txt

# --- Datos locales de Consul (pueden contener tokens ACL) --------------------
/consul/consul.json
/consul/data/

# --- Artefactos generados por las pruebas de carga ---------------------------
tests/vegeta-generated/

# --- Workspace local de Go (configuración por desarrollador) ------------------
go.work
go.work.sum
