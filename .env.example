# Copiar a .env y ajustar. El .env real NO se versiona.
#
# El modo de descubrimiento se elige con DISCOVERY:
#   consul  (default de los Compose) → las instancias se buscan en Consul.
#           EXTRACTOR_URL y PERSISTENCE_URL no se usan y pueden quedar vacías.
#   static                          → se usan las URLs fijas de abajo; no se
#           consulta Consul (desarrollo local, tests e integración por etapas).
# El binario arranca en `static` si no se define DISCOVERY; los Compose fijan
# `consul`. La variable que exige el modo elegido es obligatoria: sin ella el
# arranque falla con un mensaje explícito.

# --- Descubrimiento -----------------------------------------------------------
DISCOVERY=consul
# API HTTP de Consul dentro de la red `mired` (el agente escucha en 8500).
CONSUL_HTTP_ADDR=http://consul:8500
# Opcional: IP con la que la instancia se anuncia en Consul. Solo hace falta si
# el contenedor tiene varias redes; si se omite, se autodetecta la primera IPv4
# no loopback.
# ORCH_ADVERTISE_ADDR=172.18.0.5

# --- Downstream (solo DISCOVERY=static) ---------------------------------------
# Con DISCOVERY=consul estas dos variables no se usan: dejalas comentadas.
# EXTRACTOR_URL=http://extractor:9000
# PERSISTENCE_URL=http://persistencia:8000

# --- Imagen y réplicas --------------------------------------------------------
# Imagen ya construida con: docker build -t papersoul-orchestrator:<tag> .
ORCH_IMAGE=papersoul-orchestrator:local
ORCH_REPLICAS=2

# --- Timeouts (opcionales) ----------------------------------------------------
# EXTRACTOR_TIMEOUT=30s
# PERSISTENCE_TIMEOUT=15s
# ORCH_SHUTDOWN_TIMEOUT=10s
# ORCH_STOP_GRACE_PERIOD=15s

# --- Límites y validación (opcionales) ----------------------------------------
# ORCH_ADDR=:8080
# ORCH_MAX_FILE_SIZE=26214400
# ORCH_VALIDATION_RELAXED=true
# ORCH_MAX_CONCURRENCY=8

# --- Red (opcional) -----------------------------------------------------------
# TRAEFIK_NETWORK=mired

# --- Stack local (docker-compose.dev.yml) -------------------------------------
# Requerida por el override local; la usa Persistencia.
# MONGODB_URI=mongodb://root:CLAVE@mongodb:27017/papersoul?authSource=admin
