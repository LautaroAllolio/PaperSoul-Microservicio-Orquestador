# Copiar a .env y ajustar. El .env real NO se versiona (tiene credenciales).
# Las dos URLs downstream son OBLIGATORIAS: sin ellas, el Compose falla con un
# mensaje explícito, igual que el binario al arrancar.

# --- Descubrimiento -----------------------------------------------------------
# consul: el Orquestador y Traefik descubren los servicios por Consul
#         (requiere Consul levantado y con líder antes que los servicios).
# static: sin Consul; se usan EXTRACTOR_URL y PERSISTENCE_URL.
DISCOVERY=consul

# --- Downstream ---------------------------------------------------------------
EXTRACTOR_URL=http://extractor:9000
PERSISTENCE_URL=http://persistencia:8000

# --- Imagen y réplicas --------------------------------------------------------
# Imagen versionada que usa el Compose (sin build). Cambiala para usar otra versión.
ORCH_IMAGE=papersoul-orchestrator:v1.0.0
ORCH_REPLICAS=3

# --- Timeouts (opcionales) ----------------------------------------------------
# EXTRACTOR_TIMEOUT=30s
# PERSISTENCE_TIMEOUT=15s
# ORCH_SHUTDOWN_TIMEOUT=10s
# ORCH_STOP_GRACE_PERIOD=15s

# --- Límites y validación (opcionales) ----------------------------------------
# ORCH_ADDR=:8080
# ORCH_MAX_FILE_SIZE=26214400
# ORCH_VALIDATION_RELAXED=true
# Semáforo de concurrencia. El default del binario es 8. Para la campaña de carga
# (k6 spike 100 VUs / Vegeta) subirlo, p. ej. a 128: el middleware rechaza con 503
# sin encolar y con 8 una corrida a 100 VUs daría ~92% de 503 por diseño.
# ORCH_MAX_CONCURRENCY=8

# --- Red (opcional) -----------------------------------------------------------
# TRAEFIK_NETWORK=mired

# --- Stack local (docker-compose.dev.yml) -------------------------------------
# Requerida por el override local; la usa Persistencia.
MONGODB_URI=mongodb://<usuario>:<clave>@mongodb:27017/papersoul?authSource=admin

# Imágenes downstream versionadas para el override local.
EXTRACTOR_IMAGE=papersoul-pdfextractor:v1.0.0
PERSISTENCIA_IMAGE=papersoul-persistencia:v1.0.0
